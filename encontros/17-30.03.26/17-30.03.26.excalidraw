    {
      "id": "etVjH7StQhp-WvJq_cSX4",
      "type": "text",
      "x": 12861.852668069341,
      "y": 896.8944522379643,
      "width": 420.3036193847656,
      "height": 80,
      "angle": 0,
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1b",
      "roundness": null,
      "seed": 1205780895,
      "version": 1054,
      "versionNonce": 813755281,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775511201239,
      "link": null,
      "locked": false,
      "text": "Os autores dizem que usuarios raramente sabem\nexatamente o que precisam antes de ver o sistema\nfuncionando. Isso transfere alguma responsabilidade\npara o desenvolvedor? Ou o cliente sempre tem razao?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "NhjhxWzzT3TIkpjYUSLjD",
      "originalText": "Os autores dizem que usuarios raramente sabem exatamente o que precisam antes de ver o sistema funcionando. Isso transfere alguma responsabilidade para o desenvolvedor? Ou o cliente sempre tem razao?",
      "autoResize": true,
      "lineHeight": 1.25
    },
