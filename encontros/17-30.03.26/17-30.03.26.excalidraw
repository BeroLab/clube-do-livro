      "isDeleted": false,
      "boundElements": [],
      "updated": 1775508536157,
      "link": null,
      "locked": false,
      "text": "Dica 52: Trabalhe com\num usuario real",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "CgCj3fSM8MzkCVP4Y0Ulx",
      "originalText": "Dica 52: Trabalhe com\num usuario real",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "6ZrNeAa6uiQ6RNFnnCaWs",
      "type": "text",
      "x": 226.42014117407768,
      "y": 824.6387663429393,
      "width": 159.35989379882812,
      "height": 93.75,
      "angle": 0,
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ax",
      "roundness": null,
      "seed": 1802733681,
      "version": 417,
      "versionNonce": 688443167,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775507747039,
      "link": null,
      "locked": false,
      "text": "Requisitos estao\nenterrados sob\nsuposicoes, politicas\ne concepcoes erradas.\nE preciso escava-los.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "L0EHWnBLDP4_5vbPqtyGH",
      "originalText": "Requisitos estao\nenterrados sob\nsuposicoes, politicas\ne concepcoes erradas.\nE preciso escava-los.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "2x-yUaDXsqTroih34TJGP",
      "type": "text",
      "x": 462.5973553416054,
      "y": 339.9589659196255,
      "width": 156.4348907470703,
      "height": 93.75,
      "angle": 0,
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ay",
      "roundness": null,
      "seed": 1108883761,
      "version": 319,
      "versionNonce": 418980511,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775508429593,
      "link": null,
      "locked": false,
      "text": "Tornar-se usuario:\nobservar o trabalho\nreal cria empatia\ne revela necessidades\nverdadeiras.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "03OLu9VlrSvkO_KZHHcsG",
      "originalText": "Tornar-se usuario:\nobservar o trabalho\nreal cria empatia\ne revela necessidades\nverdadeiras.",
      "autoResize": true,
      "lineHeight": 1.25
    },
