    {
      "id": "zg6lS_QnEHOlrIG5k_HtK",
      "type": "text",
      "x": 512.6814602175056,
      "y": 776.8785792220908,
      "width": 209.42381286621094,
      "height": 180,
      "angle": 0,
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "au",
      "roundness": null,
      "seed": 580986161,
      "version": 271,
      "versionNonce": 148895391,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775509225545,
      "link": null,
      "locked": false,
      "text": "O autor propõe uma\nmudança de mentalidade na\nforma como lidamos com\nrequisitos, sugerindo que\neles não devem ser apenas\ncoletados, mas sim\nescavados para remover\ncamadas de suposições e\npolíticas",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "Rfh7-ug5oVZFoBf7tQIji",
      "originalText": "O autor propõe uma mudança de mentalidade na forma como lidamos com requisitos, sugerindo que eles não devem ser apenas coletados, mas sim escavados para remover camadas de suposições e políticas",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "7dU70p24Tc_WELPKChPIv",
      "type": "text",
      "x": 819.9907419510752,
      "y": 549.8321569504665,
      "width": 173.4078369140625,
      "height": 40,
      "angle": 0,
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "av",
      "roundness": null,
      "seed": 1094271153,
      "version": 350,
