    {
      "id": "VkhOK4lLmSLA8iIJ1okGC",
      "type": "text",
      "x": 3080.634128681573,
      "y": 1162.7572438416107,
      "width": 289.5037536621094,
      "height": 160,
      "angle": 0,
      "strokeColor": "#ffffff",
