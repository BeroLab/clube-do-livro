    {
      "id": "nteq9umAb7-aBN1O1angE",
      "type": "text",
      "x": 13508.591310444015,
      "y": 720.2277855712975,
      "width": 420.15966796875,
      "height": 100,
      "angle": 0,
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
