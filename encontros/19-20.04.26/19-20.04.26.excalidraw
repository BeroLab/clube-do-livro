      "isDeleted": false,
      "boundElements": null,
      "updated": 1776721684884,
      "link": null,
      "locked": false,
      "text": "O cérebro demora mais para responder e erra\ncom mais frequência porque a leitura da palavra\né automática e conflita com a tarefa de\nidentificar a cor.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "O cérebro demora mais para responder e erra com mais frequência porque a leitura da palavra é automática e conflita com a tarefa de identificar a cor.",
      "autoResize": false,
      "lineHeight": 1.25
    },
