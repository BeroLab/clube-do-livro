    {
      "id": "0ozKN7osijzV7aB6VI6Fa",
      "type": "text",
      "x": -3940.674527028231,
      "y": 1907.578698701794,
      "width": 564.5991210937498,
      "height": 150,
      "angle": 0,
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
