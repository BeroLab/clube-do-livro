      "seed": 1084816738,
      "version": 1437,
      "versionNonce": 1141565310,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "PQ2fi6a8RH_9O6j6wjl6T",
          "type": "arrow"
        },
        {
          "id": "5o2Yzv2rpUgc2Vcos1vmI",
