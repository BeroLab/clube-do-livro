      "updated": 1774297606764,
      "link": null,
      "locked": false,
      "text": "O(1) - Tempo Constante:\nO tempo de execução não depende do tamanho do array. Acessar um índice específico é\nimediato.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "O(1) - Tempo Constante:\nO tempo de execução não depende do tamanho do array. Acessar um índice específico é imediato.",
      "autoResize": false,
      "lineHeight": 1.25
    },
