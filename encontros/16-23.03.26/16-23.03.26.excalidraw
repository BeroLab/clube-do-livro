          "type": "arrow"
        }
      ],
      "updated": 1774300426103,
      "link": null,
      "locked": false,
      "text": "A automação e a execução frequente dos testes são o que impedem a criação de bombas-\nrelógio no código-fonte.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A automação e a execução frequente dos testes são o que impedem a criação de bombas-relógio no código-fonte.",
      "autoResize": false,
      "lineHeight": 1.25
    },
