      "isDeleted": false,
      "boundElements": null,
      "updated": 1774297632413,
      "link": null,
      "locked": false,
      "text": "O(n) - Tempo Linear:\nO tempo cresce proporcionalmente ao número de elementos. Se o array dobrar de tamanho, o\ntempo de execução dobra.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "O(n) - Tempo Linear:\nO tempo cresce proporcionalmente ao número de elementos. Se o array dobrar de tamanho, o tempo de execução dobra.",
      "autoResize": false,
      "lineHeight": 1.25
    },
