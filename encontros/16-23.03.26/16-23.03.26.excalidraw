        }
      ],
      "updated": 1774301723992,
      "link": null,
      "locked": false,
      "text": "O livro não diz para ignorar as ferramentas, diz para não abrir mão da compreensão.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "O livro não diz para ignorar as ferramentas, diz para não abrir mão da compreensão.",
      "autoResize": false,
      "lineHeight": 1.25
    },
