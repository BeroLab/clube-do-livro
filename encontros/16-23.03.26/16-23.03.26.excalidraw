      "isDeleted": false,
      "boundElements": null,
      "updated": 1774305248940,
      "link": null,
      "locked": false,
      "text": "O(n log n) - Tempo Logarítmico:\nO algoritmo \"divide para conquistar\". A cada passo, o espaço de busca cai pela metade. Muito\neficiente para grandes volumes.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "O(n log n) - Tempo Logarítmico:\nO algoritmo \"divide para conquistar\". A cada passo, o espaço de busca cai pela metade. Muito eficiente para grandes volumes.",
      "autoResize": false,
      "lineHeight": 1.25
    },
