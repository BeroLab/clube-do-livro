      "isDeleted": false,
      "boundElements": null,
      "updated": 1774297664129,
      "link": null,
      "locked": false,
      "text": "O(n^2) - Tempo Quadrático:\nComum em loops aninhados. Se você tem 10 itens, faz 100 operações. Se tem 1.000, faz\n1.000.000.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "O(n^2) - Tempo Quadrático:\nComum em loops aninhados. Se você tem 10 itens, faz 100 operações. Se tem 1.000, faz 1.000.000.",
      "autoResize": false,
      "lineHeight": 1.25
    },
