        },
        {
          "id": "3PbsCnvqn3gCRrUfsvIjR",
          "type": "arrow"
        }
      ],
      "updated": 1774301378578,
      "link": null,
      "locked": false,
      "text": "O capítulo aborda como o desenvolvimento de software ficou cada vez mais complexo ao longo\ndos anos, exigindo interfaces sofisticadas, múltiplas camadas e integração com diversas\ntecnologias.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "O capítulo aborda como o desenvolvimento de software ficou cada vez mais complexo ao longo dos anos, exigindo interfaces sofisticadas, múltiplas camadas e integração com diversas tecnologias.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "dInM7GnQG7q-adseihXBO",
      "type": "text",
      "x": 12270.753837302509,
      "y": 631.930211302651,
      "width": 924.8197631835936,
      "height": 50,
      "angle": 0,
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0A",
      "roundness": null,
      "seed": 1447141438,
      "version": 1310,
      "versionNonce": 2141760290,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "PQ2fi6a8RH_9O6j6wjl6T",
          "type": "arrow"
        },
        {
          "id": "5o2Yzv2rpUgc2Vcos1vmI",
          "type": "arrow"
        },
        {
          "id": "4_dkWEUow9DKFeTJP6xLK",
          "type": "arrow"
        },
        {
          "id": "3PbsCnvqn3gCRrUfsvIjR",
          "type": "arrow"
        },
        {
          "id": "rLO6n3g9GyZzqzsVKBv6o",
          "type": "arrow"
        }
      ],
      "updated": 1774301381410,
      "link": null,
      "locked": false,
      "text": "Para lidar com essa complexidade, surgiram os assistentes, ferramentas que geram código\nautomaticamente a partir de respostas simples do desenvolvedor.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Para lidar com essa complexidade, surgiram os assistentes, ferramentas que geram código automaticamente a partir de respostas simples do desenvolvedor.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "jR3GL2ROqm-CchhUBB25U",
      "type": "text",
      "x": 11575.065318775334,
      "y": 785.9166027553064,
      "width": 924.8197631835936,
      "height": 50,
      "angle": 0,
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0B",
      "roundness": null,
      "seed": 2011241890,
      "version": 1351,
      "versionNonce": 2115624382,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "PQ2fi6a8RH_9O6j6wjl6T",
          "type": "arrow"
        },
        {
          "id": "5o2Yzv2rpUgc2Vcos1vmI",
          "type": "arrow"
        },
        {
          "id": "4_dkWEUow9DKFeTJP6xLK",
          "type": "arrow"
        },
        {
          "id": "rLO6n3g9GyZzqzsVKBv6o",
          "type": "arrow"
        },
        {
          "id": "3AEZcK3skXMyLtCcmYT4K",
          "type": "arrow"
        }
      ],
      "updated": 1774301384498,
      "link": null,
      "locked": false,
      "text": "Os autores reconhecem o valor dos assistentes, mas levantam um ponto crítico: usar código\ngerado automaticamente sem entendê-lo é programar baseado no acaso.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Os autores reconhecem o valor dos assistentes, mas levantam um ponto crítico: usar código gerado automaticamente sem entendê-lo é programar baseado no acaso.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "hdH5x4bJOtXjb-_GJIaNj",
      "type": "text",
      "x": 12390.483163531155,
      "y": 1021.0603533360547,
      "width": 924.8197631835936,
      "height": 75,
      "angle": 0,
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0C",
      "roundness": null,
      "seed": 2049365566,
      "version": 1376,
      "versionNonce": 820302462,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "PQ2fi6a8RH_9O6j6wjl6T",
          "type": "arrow"
        },
        {
          "id": "5o2Yzv2rpUgc2Vcos1vmI",
          "type": "arrow"
        },
        {
          "id": "4_dkWEUow9DKFeTJP6xLK",
          "type": "arrow"
        },
        {
          "id": "3AEZcK3skXMyLtCcmYT4K",
          "type": "arrow"
        },
        {
          "id": "Zk8JcM5bBjcKkCYvx8taU",
          "type": "arrow"
        }
      ],
      "updated": 1774301387242,
      "link": null,
      "locked": false,
      "text": "O capítulo termina com a Dica 50: não use um código de assistente que você não entender,\nreforçando que nenhum desenvolvedor deve colocar em produção código que não compreende\nintegralmente.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "O capítulo termina com a Dica 50: não use um código de assistente que você não entender, reforçando que nenhum desenvolvedor deve colocar em produção código que não compreende integralmente.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "9lTzSX5ZwHE5szRMRSYGU",
      "type": "text",
      "x": 11567.480036498537,
      "y": 1282.752591885597,
      "width": 924.8197631835936,
      "height": 75,
      "angle": 0,
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0D",
