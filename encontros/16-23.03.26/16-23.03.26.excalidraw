    {
      "id": "deIopfDdX1ztUm1hPEpqB",
      "type": "text",
      "x": 4148.988444481474,
      "y": 1821.866918025,
      "width": 924.8197631835936,
      "height": 75,
      "angle": 0,
      "strokeColor": "#ffffff",
