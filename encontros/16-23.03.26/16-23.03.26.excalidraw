      "isDeleted": false,
      "boundElements": [
        {
          "id": "UPHjBKWT_XJydwVEHviVh",
          "type": "arrow"
        }
      ],
      "updated": 1774298832875,
      "link": null,
      "locked": false,
      "text": "Por que um algoritmo O(n^2) pode ser, na prática, \"melhor\" do que um O(n log n) para um\nconjunto pequeno de dados?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Por que um algoritmo O(n^2) pode ser, na prática, \"melhor\" do que um O(n log n) para um conjunto pequeno de dados?",
      "autoResize": false,
      "lineHeight": 1.25
    },
