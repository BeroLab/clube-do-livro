    {
      "id": "OjFtdVeS-vN8VnLaFWIV7",
      "type": "text",
      "x": 2582.2324560929173,
      "y": 449.5127051308522,
      "width": 924.8197631835936,
      "height": 75,
      "angle": 0,
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aI",
      "roundness": null,
      "seed": 1953216034,
      "version": 575,
      "versionNonce": 569095422,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1774298685407,
      "link": null,
      "locked": false,
      "text": "O autor destaca que programadores pragmáticos estimam recursos diariamente. A questão\ncentral não é apenas como o código roda agora, mas como ele se comportará quando a entrada\ncrescer (ex: de 1.000 para 1.000.000 de registros).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "O autor destaca que programadores pragmáticos estimam recursos diariamente. A questão central não é apenas como o código roda agora, mas como ele se comportará quando a entrada crescer (ex: de 1.000 para 1.000.000 de registros).",
      "autoResize": false,
      "lineHeight": 1.25
    },
