      "boundElements": [
        {
          "id": "KzUQ6G1FhBJnp4jvdruqW",
          "type": "arrow"
        }
      ],
      "updated": 1774305132445,
      "link": null,
      "locked": false,
      "text": "O Perigo do O(n^2) no Big Data: Se em 1999 falar em 1.000.000 de\nregistros era um exemplo de \"grande escala\", hoje lidamos com bilhões\nde eventos. O crescimento quadrático é o \"assassino silencioso\" de\nsistemas modernos de análise de dados e microsserviços.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "O Perigo do O(n^2) no Big Data: Se em 1999 falar em 1.000.000 de registros era um exemplo de \"grande escala\", hoje lidamos com bilhões de eventos. O crescimento quadrático é o \"assassino silencioso\" de sistemas modernos de análise de dados e microsserviços.",
      "autoResize": false,
      "lineHeight": 1.25
    },
