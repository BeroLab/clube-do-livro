    {
      "id": "YyxyxaN1-bxtDn3-jFEWq",
      "type": "text",
      "x": 1856.1782187940385,
      "y": 823.7487911058421,
      "width": 843.2331159040732,
      "height": 175,
      "angle": 0,
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aQ",
      "roundness": null,
      "seed": 1460950583,
      "version": 89,
      "versionNonce": 711808247,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1771885294448,
      "link": null,
      "locked": false,
      "text": "Processo de Eliminação\n\n\"Select\" não está com defeito: É muito mais provável que o erro esteja no seu código\ndo que no sistema operacional, no compilador ou no banco de dados.\n\nBusca Binária no Código: Se não souber por onde começar, divida o caminho do código\nao meio e verifique em qual metade o erro persiste até isolar a causa raiz.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Processo de Eliminação\n\n\"Select\" não está com defeito: É muito mais provável que o erro esteja no seu código do que no sistema operacional, no compilador ou no banco de dados.\n\nBusca Binária no Código: Se não souber por onde começar, divida o caminho do código ao meio e verifique em qual metade o erro persiste até isolar a causa raiz.",
      "autoResize": false,
      "lineHeight": 1.25
    },
