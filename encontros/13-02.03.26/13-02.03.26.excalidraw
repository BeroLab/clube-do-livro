    },
    {
      "id": "_usARN18l9NYcHQXJJLF6",
      "type": "text",
      "x": 9922.416075874404,
      "y": 196.84266358880205,
      "width": 408.1957092285156,
      "height": 47.18198992395785,
      "angle": 0,
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0L",
