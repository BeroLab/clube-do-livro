    },
    {
      "id": "bqOpu55smc7xLB7W6-pnH",
      "type": "text",
      "x": 400.68179439419885,
      "y": 555.6364112116023,
      "width": 737.933851280582,
      "height": 75,
      "angle": 0,
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a3",
      "roundness": null,
      "seed": 265297022,
      "version": 161,
      "versionNonce": 707555938,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772475044987,
      "link": null,
      "locked": false,
      "text": "Este trecho do livro introduz uma abordagem rigorosa para a interação\nentre módulos de software, baseada na ideia de contratos legais e na\nfilosofia de Bertrand Meyer.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Este trecho do livro introduz uma abordagem rigorosa para a interação entre módulos de software, baseada na ideia de contratos legais e na filosofia de Bertrand Meyer.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "c32Eh18HChVMo3vDqknvY",
      "type": "text",
      "x": -345.92857591160646,
      "y": 2557.9153377683974,
      "width": 737.933851280582,
      "height": 100,
      "angle": 0,
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a6",
      "roundness": null,
      "seed": 91616290,
      "version": 426,
      "versionNonce": 1346699170,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772477718194,
      "link": null,
      "locked": false,
      "text": "Filosofia do Código \"Preguiçoso\": O livro sugere que o desenvolvedor seja\nrigoroso no que aceita (pré-condições) e prometa o mínimo possível em\ntroca (pós-condições). Isso reduz a complexidade do código e evita que ele\ntente \"resolver tudo\" para todos.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Filosofia do Código \"Preguiçoso\": O livro sugere que o desenvolvedor seja rigoroso no que aceita (pré-condições) e prometa o mínimo possível em troca (pós-condições). Isso reduz a complexidade do código e evita que ele tente \"resolver tudo\" para todos.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "W5Rd03qhRjslfGgLIsKrk",
      "type": "text",
      "x": 888.9738500816652,
      "y": 3012.060680059462,
      "width": 737.933851280582,
      "height": 100,
      "angle": 0,
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a7",
      "roundness": null,
      "seed": 712708578,
      "version": 479,
      "versionNonce": 1505903998,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772478715662,
      "link": null,
      "locked": false,
      "text": "Impacto no Debugging (Travamento Antecipado): Utilizar DBC facilita\nencontrar bugs, pois o programa falha exatamente onde o contrato é\nquebrado (fail-fast), em vez de propagar valores inválidos (como NaN ou\nnull) que causam erros misteriosos muito depois da origem do problema",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Impacto no Debugging (Travamento Antecipado): Utilizar DBC facilita encontrar bugs, pois o programa falha exatamente onde o contrato é quebrado (fail-fast), em vez de propagar valores inválidos (como NaN ou null) que causam erros misteriosos muito depois da origem do problema",
      "autoResize": false,
      "lineHeight": 1.25
    },
