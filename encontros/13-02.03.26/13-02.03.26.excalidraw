    },
    {
      "id": "ZWb8E5kYdK4ivTY4U4-fa",
      "type": "text",
      "x": 4509.916075874403,
      "y": 291.842663588802,
      "width": 737.326171875,
      "height": 47.18198992395785,
      "angle": 0,
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aZ",
