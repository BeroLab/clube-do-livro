    {
      "id": "WBJib047hOQOJ7-WhzYpM",
      "type": "text",
      "x": 7039.390344226563,
      "y": 1280.1137101560612,
      "width": 621.244698660714,
      "height": 50,
      "angle": 0,
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0G",
      "roundness": null,
      "seed": 718213950,
      "version": 1694,
      "versionNonce": 1178256816,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772486398879,
      "link": null,
      "locked": false,
      "text": "Garantir que a saída de uma função complexa respeita uma\nregra fundamental",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Garantir que a saída de uma função complexa respeita uma regra fundamental",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "7XFAqNouT_Yet7ANBOkQO",
      "type": "text",
      "x": 7848.429781570898,
      "y": 918.8058294749062,
      "width": 475.79949951171875,
      "height": 75,
      "angle": 0,
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0I",
      "roundness": null,
      "seed": 1940523952,
      "version": 306,
      "versionNonce": 1891569072,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1772486386829,
      "link": null,
      "locked": false,
      "text": "O console.assert() é como um fiscal que fica em\nsilêncio em um canto. Ele só abre a boca se ver\nalgo que não deveria estar acontecendo.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "O console.assert() é como um fiscal que fica em silêncio em um canto. Ele só abre a boca se ver algo que não deveria estar acontecendo.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "oApeLtPGApUOQfiKRRIJm",
