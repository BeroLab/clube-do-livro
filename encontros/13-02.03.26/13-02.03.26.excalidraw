      "isDeleted": false,
      "boundElements": [],
      "updated": 1772488155479,
      "link": null,
      "locked": false,
      "text": "Imagine que seu App precisa obrigatoriamente de um\narquivo .env para rodar. Se ele não existir, o sistema não\ndeve sequer iniciar.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Imagine que seu App precisa obrigatoriamente de um arquivo .env para rodar. Se ele não existir, o sistema não deve sequer iniciar.",
