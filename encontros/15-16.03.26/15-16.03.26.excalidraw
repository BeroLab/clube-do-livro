      ],
      "updated": 1773696748621,
      "link": null,
      "locked": false,
      "text": "Interface Única vs. Explosão de APIs: Em arquiteturas\ntradicionais, à medida que o número de módulos aumenta, o\nnúmero de interfaces entre eles explode combinatorialmente. O\nquadro-negro simplifica isso drasticamente ao oferecer uma única\ninterface consistente (read, write, take, notify) para todo o\nsistema.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Interface Única vs. Explosão de APIs: Em arquiteturas tradicionais, à medida que o número de módulos aumenta, o número de interfaces entre eles explode combinatorialmente. O quadro-negro simplifica isso drasticamente ao oferecer uma única interface consistente (read, write, take, notify) para todo o sistema.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "F6KvoTq7KrmnJRMdxYMo9",
      "type": "text",
      "x": 10816.717754572102,
      "y": 1301.4562986082437,
      "width": 630.198486328125,
      "height": 1050,
      "angle": 0,
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "au",
      "roundness": null,
      "seed": 404521302,
      "version": 411,
      "versionNonce": 196402582,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "g14WWHG0YHW8w1MAFIp0A",
          "type": "arrow"
        },
        {
          "id": "hHWB1PzBJWeR9o9nyT3g5",
