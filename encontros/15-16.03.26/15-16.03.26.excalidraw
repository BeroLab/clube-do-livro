      "version": 403,
      "versionNonce": 1948834506,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "g14WWHG0YHW8w1MAFIp0A",
          "type": "arrow"
        },
        {
          "id": "hHWB1PzBJWeR9o9nyT3g5",
          "type": "arrow"
        },
        {
          "id": "o4mLkji0GRNouNhfxHpu6",
