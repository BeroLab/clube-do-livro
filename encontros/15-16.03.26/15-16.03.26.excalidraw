      "versionNonce": 1573823382,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "g14WWHG0YHW8w1MAFIp0A",
          "type": "arrow"
        },
        {
          "id": "hHWB1PzBJWeR9o9nyT3g5",
