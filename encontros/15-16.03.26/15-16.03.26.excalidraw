      "locked": false,
      "text": "Vinculação temporal",
      "fontSize": 91.99999999999997,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Vinculação temporal",
