        },
        {
          "id": "vJg2OKO5tV44UdaZehbos",
          "type": "arrow"
        }
      ],
      "updated": 1773082256233,
      "link": null,
      "locked": false,
      "text": "Desenvolvimento Frontend (JavaScript/React): No lado do\ncliente, esquecer de remover um Event Listener ou não limpar\num setInterval em um componente que foi destruído causa\nvazamentos de memória que tornam a interface lenta.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Desenvolvimento Frontend (JavaScript/React): No lado do cliente, esquecer de remover um Event Listener ou não limpar um setInterval em um componente que foi destruído causa vazamentos de memória que tornam a interface lenta.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "b65B70vNtIWmdG7V_8Z0E",
      "type": "text",
