        }
      ],
      "updated": 1773082344340,
      "link": null,
      "locked": false,
      "text": "A Era do Cloud e Custos: Em arquiteturas Serverless ou baseadas\nem microserviços, conexões zumbis ou instâncias de recursos não\nfinalizadas escalam custos de forma invisível e rápida. Eles podem\nderrubar o sevidor e queimar dinheiro.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A Era do Cloud e Custos: Em arquiteturas Serverless ou baseadas em microserviços, conexões zumbis ou instâncias de recursos não finalizadas escalam custos de forma invisível e rápida. Eles podem derrubar o sevidor e queimar dinheiro.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "VaIiw_xlQjXgi_-bKk5jc",
      "type": "text",
      "x": 2615.01994474491,
      "y": 1341.3958071199156,
      "width": 589.276990762546,
      "height": 100,
      "angle": 0,
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a9",
      "roundness": null,
      "seed": 1808486401,
      "version": 111,
      "versionNonce": 343996079,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "sA2qhwgt14MUOH6s9lnOk",
