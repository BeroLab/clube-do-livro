    {
      "id": "C_EYAttUYexN-M9-mrMD3",
      "type": "text",
      "x": 4601.297268766123,
      "y": 460.84245450187746,
      "width": 1267.777099609375,
      "height": 93.08789391760526,
      "angle": 0,
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
