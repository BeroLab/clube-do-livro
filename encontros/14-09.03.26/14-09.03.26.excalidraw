    {
      "id": "KYRIdU_e-vZsk-qkjm77E",
      "type": "text",
      "x": 5728.751410655832,
      "y": 1611.9001912927033,
      "width": 679.499644270398,
      "height": 150,
      "angle": 0,
      "strokeColor": "#ffffff",
