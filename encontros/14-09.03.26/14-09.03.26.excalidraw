        }
      ],
      "updated": 1773082941718,
      "link": null,
      "locked": false,
      "text": "No software moderno, a complexidade apenas mudou de lugar (da RAM\npara a Rede/Cloud), tornando o equilíbrio entre alocação e liberação\nainda mais crítico para a escalabilidade.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "No software moderno, a complexidade apenas mudou de lugar (da RAM para a Rede/Cloud), tornando o equilíbrio entre alocação e liberação ainda mais crítico para a escalabilidade.",
      "autoResize": false,
      "lineHeight": 1.25
    },
